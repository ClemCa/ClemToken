# NAME RULES
# TODO implement specs
$name: [a-zA-Z_][a-zA-Z0-9_] ;

# MAIN
@statement: [@import | @declaration | @call] ;

## STATEMENTS
@import: import @identifier (. @identifier)* from @identifier
@declaration: [var | @type] @identifier = @expression

## SUB
@expression: [@literal | @call | @lambda | @identifier]

@arguments: @expression (, @expression)*

@implicit_parameters: @implicit_parameter (, @implicit_parameter)*
@parameters: @parameter (, @parameter)*

@parameter: @type @identifier
@implicit_parameter: @identifier

## FUNCS
@call: @identifier ( (@arguments):? )
###################TODO################### FIX LAMBDAS, issue with optionals (parameters), instead of assuming there is something and continuing if none,
########################################## maybe we should assume there's nothing and redo the step if there is, just like expansion works but
########################################## by instead stepping back, that or treat repeat 0 results for groups more positively? the parser
########################################## seems to prefer the next option in the optional to an empty group somehow, it could be outdated logic somewhere
@lambda: [inline:(( (@implicit_parameters):? ) => @expression) | long:(( parameters:(@implicit_parameters):? ) => { body:(@statement)* })]

## VALUES
@literal: [@string | @number | @boolean]
@string: " content:(($$[greedy]):) "
@boolean: [true | false]

### NUMBERS
@number: [@integer | @float]
@integer: ($[digit]):+
@float: @integer . @integer


# BASIC
@identifier: $[name]
@type: $[name]