# NAME SPECS
$name: [a-zA-Z_][a-zA-Z0-9_]*
# COMMENT SPECS
$comment: (?<=^.*)\/\/\/
$comment: (?<=^\s*)\/\/
$comment_begin:simple: /*
$comment_end:simple: */
# escape needs to be escaped if it's at the end of the line (DSL uses escapes for multi-line rules)
$comment_escape:simple: \\

# MAIN
@statement: [@import | @declaration | @call | @chain_call | @guarded | @plain] ;

## STATEMENTS
@import: import @identifier (. @identifier)* from @identifier
@declaration: [var | @type] @identifier = @expression

## SUB
@expression: [@literal | @call | @lambda | @identifier]

@arguments: @expression (, @expression)*

@implicit_parameters: @implicit_parameter (, @implicit_parameter)*
@parameters: @parameter (, @parameter)*

@parameter: @type @identifier
@implicit_parameter: @identifier

## FUNCS
@call: @identifier ( (@arguments):? )
@lambda: [inline:(( parameters:(@implicit_parameters):? ) => @expression): | long:(( parameters:(@implicit_parameters):? ) => body:({ statements:(@statement):* })):]

## CALL CHAINS
# Regression: chain_call -> chain_method_call -> chain_call is an indirect leading cycle, not a
# left-recursive operator chain. The normaliser must leave these nodes alone; 1.8.2 crashed here.
@chain_call: @>( [@chain_method_call | @chain_simple_call]
@chain_method_call?: @>. expression:@chain_call . @chain_call
@chain_simple_call?: @chain_identifier ( )
@chain_identifier: [@composed_identifier | @identifier]
@composed_identifier: @identifier (. @identifier)+

## VALUES
@literal: [@string | @number | @boolean]
@string: " content:(($$[greedy]):) "
@boolean: [true | false]

### NUMBERS
@number: [@float | @integer]
@integer: ($$[digit]):+
@float: @integer . @integer


# BASIC
@identifier: $[name]
@type: $[name]

# LOOKAHEAD
# a regression case for the lookahead cache: @outer probes @>mark at a shallower search stack
# than @inner. the stack key must read outermost-first so @inner sees @outer's cached entry, skips
# the only "mark" and fails, letting @guarded fall through to @plain. under the old top-first key
# @inner missed the ancestor entry and @guarded matched instead.
@guarded: @outer
@outer: @>mark @inner
@inner: @>mark @leaf
@leaf: @identifier
@plain: @identifier